rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /jobs/{jobId} {
      // Keep in sync with src/lib/yasmin/auth.ts ALLOWED_EMAILS.
      function isAdmin() {
        return request.auth != null
          && request.auth.token.email_verified == true
          && request.auth.token.email in [
            'moh.noor94@gmail.com',
            'yasmin@hirefound.com'
          ];
      }

      // Public: active jobs only. Admins: all jobs (incl. inactive).
      allow read: if resource.data.isActive == true || isAdmin();

      // Admins only create/update/delete.
      allow create, update, delete: if isAdmin();
    }

    match /reels/{reelId} {
      function isAdmin() {
        return request.auth != null
          && request.auth.token.email_verified == true
          && request.auth.token.email in [
            'moh.noor94@gmail.com',
            'yasmin@hirefound.com'
          ];
      }

      // Public: active reels only. Admins: all reels (incl. inactive).
      allow read: if resource.data.isActive == true || isAdmin();

      // Admins only create/update/delete.
      allow create, update, delete: if isAdmin();
    }
  }
}
